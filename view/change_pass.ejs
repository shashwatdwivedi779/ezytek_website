<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Change Password – Ezytek Clean</title>

  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/css/after.css" />
  <link rel="stylesheet" href="/css/footer.css" />

  <style>
    .security-card {
      max-width: 560px;
      margin: 0 auto 3rem auto;
      background: var(--bg-surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-card);
      overflow: hidden;
    }

    .security-header {
      padding: 24px 28px;
      background: linear-gradient(135deg, rgba(2, 132, 199, 0.06), rgba(15, 32, 56, 0.03));
      border-bottom: 1px solid var(--border-light);
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .security-header-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, #7C3AED, #9333EA);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);
      flex-shrink: 0;
    }

    .security-header-text h2 {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--brand-navy);
      margin: 0 0 4px 0;
    }

    .security-header-text p {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin: 0;
    }

    .security-body {
      padding: 28px;
    }

    /* Account Badge */
    .user-pill-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #F1F5F9;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.82rem;
      color: var(--text-secondary);
      margin-bottom: 22px;
      border: 1px solid #E2E8F0;
    }

    .user-pill-badge i {
      color: var(--brand-blue);
    }

    /* Form Styles */
    .form-group {
      margin-bottom: 20px;
      position: relative;
    }

    .form-label {
      display: block;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--brand-navy);
      margin-bottom: 8px;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-icon-left {
      position: absolute;
      left: 14px;
      color: #94A3B8;
      font-size: 0.95rem;
      pointer-events: none;
    }

    .form-control {
      width: 100%;
      height: 46px;
      padding: 0 44px 0 40px;
      background: #FFFFFF;
      border: 1px solid var(--border-medium);
      border-radius: var(--radius-md);
      font-size: 0.92rem;
      color: var(--text-primary);
      font-family: inherit;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--brand-blue);
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    }

    .btn-toggle-eye {
      position: absolute;
      right: 12px;
      background: none;
      border: none;
      color: #94A3B8;
      cursor: pointer;
      font-size: 0.95rem;
      padding: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.2s ease;
    }

    .btn-toggle-eye:hover {
      color: var(--brand-navy);
    }

    /* Password Requirements Checklist */
    .pwd-requirements {
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: var(--radius-md);
      padding: 12px 16px;
      margin-top: 14px;
      margin-bottom: 22px;
    }

    .pwd-requirements-title {
      font-size: 0.78rem;
      font-weight: 700;
      color: #64748B;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }

    .req-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.82rem;
      color: #64748B;
      margin-bottom: 4px;
      transition: color 0.2s ease;
    }

    .req-item:last-child {
      margin-bottom: 0;
    }

    .req-item i {
      font-size: 0.75rem;
      transition: color 0.2s ease;
    }

    .req-item.met {
      color: #059669;
      font-weight: 600;
    }

    .req-item.met i {
      color: #059669;
    }

    /* Alerts */
    .alert {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 14px 16px;
      border-radius: var(--radius-md);
      font-size: 0.88rem;
      line-height: 1.45;
      margin-bottom: 22px;
    }

    .alert-danger {
      background: #FEF2F2;
      border: 1px solid #FCA5A5;
      color: #991B1B;
    }

    .alert-success {
      background: #F0FDF4;
      border: 1px solid #86EFAC;
      color: #166534;
    }

    /* Actions */
    .form-actions {
      display: flex;
      gap: 12px;
      margin-top: 24px;
    }

    .btn-submit-pwd {
      flex: 1;
      height: 46px;
      background: var(--brand-blue);
      color: #FFFFFF;
      border: none;
      border-radius: var(--radius-md);
      font-size: 0.92rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
    }

    .btn-submit-pwd:hover {
      background: #0274b3;
      transform: translateY(-1px);
    }

    .btn-cancel {
      height: 46px;
      padding: 0 20px;
      background: #F1F5F9;
      color: var(--text-secondary);
      border: 1px solid #E2E8F0;
      border-radius: var(--radius-md);
      font-size: 0.92rem;
      font-weight: 600;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }

    .btn-cancel:hover {
      background: #E2E8F0;
      color: var(--brand-navy);
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 20px;
    }

    .breadcrumb a {
      color: var(--brand-blue);
      text-decoration: none;
      font-weight: 500;
    }

    .breadcrumb a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>

<% if (!user) { %>
  <!-- Fallback Guard -->
  <main class="dash-wrap" style="text-align:center; padding: 80px 20px;">
    <div style="max-width: 440px; margin: 0 auto; background: var(--bg-surface); padding: 36px; border: 1px solid var(--border-light); border-radius: var(--radius-lg); box-shadow: var(--shadow-card);">
      <i class="fa-solid fa-lock" style="font-size: 2.5rem; color: var(--brand-blue); margin-bottom: 16px;"></i>
      <h2 style="font-size: 1.35rem; color: var(--brand-navy); margin-bottom: 8px;">Access Restricted</h2>
      <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 24px;">Please sign in to manage your security credentials.</p>
      <a href="/login" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px; background: var(--brand-blue); color: #fff; border-radius: var(--radius-md); font-weight: 600;">
        <i class="fa-solid fa-right-to-bracket"></i> Sign In
      </a>
    </div>
  </main>
<% } else { %>

  <!-- ══ EXECUTIVE DASHBOARD NAVBAR ══════════════════════════════ -->
  <nav class="navbar" role="navigation" aria-label="Dashboard Navigation">
    <a href="/" class="nav-logo" aria-label="Ezytek Clean - Home">
      <div class="nav-logo-mark" aria-hidden="true">
        <img src="/uploads/logo_op.jpeg" alt="Ezytek Clean Logo" class="nav-logo-img" onerror="this.onerror=null; this.src='/logo_op.jpeg';" />
      </div>
      <div>
        <div class="nav-logo-name">EZYTEK</div>
        <div class="nav-logo-tag">Clean Pvt. Ltd.</div>
      </div>
    </a>

    <!-- Role-Based Nav Links -->
    <ul class="nav-links" role="list">
      <li><a href="/"><i class="fa-solid fa-house" style="margin-right: 6px;"></i>Home</a></li>
      <% if (user.role === 'Admin') { %>
        <li><a href="/master/upload"><i class="fa-solid fa-plus-circle" style="margin-right: 6px;"></i>Upload Product</a></li>
        <li><a href="/master/products"><i class="fa-solid fa-boxes-stacked" style="margin-right: 6px;"></i>All Products</a></li>
        <li><a href="/master/quotes"><i class="fa-solid fa-file-invoice-dollar" style="margin-right: 6px;"></i>Manage Quotes</a></li>
        <li><a href="/master/costomer_data"><i class="fa-solid fa-users" style="margin-right: 6px;"></i>Customers</a></li>
        <li><a href="/master/workproof"><i class="fa-solid fa-video" style="margin-right: 6px;"></i>Work Proof</a></li>
      <% } else { %>
        <li><a href="/user"><i class="fa-solid fa-gauge" style="margin-right: 6px;"></i>Dashboard</a></li>
        <li><a href="/user/card"><i class="fa-solid fa-cart-shopping" style="margin-right: 6px;"></i>My Cart</a></li>
        <li><a href="/user/orders"><i class="fa-solid fa-box-open" style="margin-right: 6px;"></i>My Orders</a></li>
        <li><a href="/user/change_pass" class="active"><i class="fa-solid fa-key" style="margin-right: 6px;"></i>Change Password</a></li>
      <% } %>
    </ul>

    <!-- User Header Controls -->
    <div class="nav-right">
      <div class="avatar" title="<%= user.userName %>"><%= (user.userName || 'U').charAt(0).toUpperCase() %></div>
      <span class="nav-username"><%= user.userName %></span>
      <span class="nav-role-badge <%= user.role === 'Admin' ? 'admin' : '' %>"><%= user.role %></span>
      
      <form action="/logout" method="GET" style="margin:0;">
        <button type="submit" class="btn-logout" aria-label="Sign out of account">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
          <span>Logout</span>
        </button>
      </form>

      <button class="hamburger" id="hamburger" aria-label="Open mobile menu" aria-expanded="false">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-menu" id="mobileMenu" role="dialog" aria-label="Mobile Navigation">
    <a href="/"><i class="fa-solid fa-house" style="margin-right: 8px;"></i>Home</a>
    <% if (user.role === 'Admin') { %>
      <a href="/master/upload"><i class="fa-solid fa-plus-circle" style="margin-right: 8px;"></i>Upload Product</a>
      <a href="/master/products"><i class="fa-solid fa-boxes-stacked" style="margin-right: 8px;"></i>All Products</a>
      <a href="/master/quotes"><i class="fa-solid fa-file-invoice-dollar" style="margin-right: 8px;"></i>Manage Quotes</a>
      <a href="/master/costomer_data"><i class="fa-solid fa-users" style="margin-right: 8px;"></i>Customers</a>
      <a href="/master/workproof"><i class="fa-solid fa-video" style="margin-right: 8px;"></i>Work Proof</a>
    <% } else { %>
      <a href="/user"><i class="fa-solid fa-gauge" style="margin-right: 8px;"></i>Dashboard</a>
      <a href="/user/card"><i class="fa-solid fa-cart-shopping" style="margin-right: 8px;"></i>My Cart</a>
      <a href="/user/orders"><i class="fa-solid fa-box-open" style="margin-right: 8px;"></i>My Orders</a>
      <a href="/user/change_pass" class="active"><i class="fa-solid fa-key" style="margin-right: 8px;"></i>Change Password</a>
    <% } %>
    <form action="/logout" method="GET" style="margin-top: 0.8rem;">
      <button type="submit" class="btn-logout" style="width: 100%; justify-content: center;">
        <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
      </button>
    </form>
  </div>

  <!-- ══ MAIN DASHBOARD CONTENT ═════════════════════════════════ -->
  <main class="dash-wrap">

    <!-- Breadcrumb -->
    <div class="breadcrumb">
      <a href="/user"><i class="fa-solid fa-gauge"></i> Dashboard</a>
      <span>/</span>
      <span>Security Settings</span>
      <span>/</span>
      <span style="color: var(--brand-navy); font-weight: 600;">Change Password</span>
    </div>

    <!-- Security Card -->
    <div class="security-card">
      <div class="security-header">
        <div class="security-header-icon">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <div class="security-header-text">
          <h2>Update Account Password</h2>
          <p>Protect your commercial quotations and account security.</p>
        </div>
      </div>

      <div class="security-body">

        <!-- User Identity Chip -->
        <div class="user-pill-badge">
          <i class="fa-solid fa-circle-user"></i>
          <span>Signed in as <strong><%= user.userName %></strong> (<%= user.email %>)</span>
        </div>

        <!-- Alert messages (Server-side & Client-side) -->
        <div id="dynamicAlert" style="display: none;"></div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger" role="alert">
            <i class="fa-solid fa-circle-exclamation" style="margin-top: 2px;"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success" role="alert">
            <i class="fa-solid fa-circle-check" style="margin-top: 2px;"></i>
            <div><%= success %></div>
          </div>
        <% } %>

        <!-- Change Password Form -->
        <form id="changePasswordForm" action="/user/change_pass" method="POST" novalidate>

          <!-- Current Password -->
          <div class="form-group">
            <label class="form-label" for="currentPassword">Current Password</label>
            <div class="input-wrapper">
              <i class="fa-solid fa-lock input-icon-left"></i>
              <input 
                type="password" 
                id="currentPassword" 
                name="currentPassword" 
                class="form-control" 
                placeholder="Enter your current password" 
                required 
                autocomplete="current-password"
              />
              <button type="button" class="btn-toggle-eye" data-target="currentPassword" aria-label="Toggle password visibility">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>

          <!-- New Password -->
          <div class="form-group">
            <label class="form-label" for="newPassword">New Password</label>
            <div class="input-wrapper">
              <i class="fa-solid fa-key input-icon-left"></i>
              <input 
                type="password" 
                id="newPassword" 
                name="newPassword" 
                class="form-control" 
                placeholder="Enter at least 6 characters" 
                minlength="6" 
                required 
                autocomplete="new-password"
              />
              <button type="button" class="btn-toggle-eye" data-target="newPassword" aria-label="Toggle password visibility">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>

          <!-- Confirm New Password -->
          <div class="form-group">
            <label class="form-label" for="confirmPassword">Confirm New Password</label>
            <div class="input-wrapper">
              <i class="fa-solid fa-check-double input-icon-left"></i>
              <input 
                type="password" 
                id="confirmPassword" 
                name="confirmPassword" 
                class="form-control" 
                placeholder="Re-enter your new password" 
                required 
                autocomplete="new-password"
              />
              <button type="button" class="btn-toggle-eye" data-target="confirmPassword" aria-label="Toggle password visibility">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>

          <!-- Live Requirements Box -->
          <div class="pwd-requirements">
            <div class="pwd-requirements-title">Security Checklist</div>
            <div class="req-item" id="req-length">
              <i class="fa-regular fa-circle"></i>
              <span>At least 6 characters in length</span>
            </div>
            <div class="req-item" id="req-diff">
              <i class="fa-regular fa-circle"></i>
              <span>Different from current password</span>
            </div>
            <div class="req-item" id="req-match">
              <i class="fa-regular fa-circle"></i>
              <span>New password &amp; confirmation match</span>
            </div>
          </div>

          <!-- Form Buttons -->
          <div class="form-actions">
            <button type="submit" class="btn-submit-pwd" id="btnSubmit">
              <i class="fa-solid fa-shield-halved"></i>
              <span>Update Password</span>
            </button>
            <a href="/user" class="btn-cancel">
              <span>Cancel</span>
            </a>
          </div>

        </form>

      </div>
    </div>

  </main>

  <!-- Global Footer -->
  <%- include('footer') %>

<% } %>

<script>
  // Mobile Hamburger Menu Toggle
  const hamburgerBtn = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');
  if (hamburgerBtn && mobileMenu) {
    hamburgerBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('open');
      hamburgerBtn.setAttribute('aria-expanded', isOpen);
    });
  }

  // Password Visibility Eye Toggles
  document.querySelectorAll('.btn-toggle-eye').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const input = document.getElementById(targetId);
      const icon = btn.querySelector('i');
      if (input) {
        if (input.type === 'password') {
          input.type = 'text';
          icon.classList.remove('fa-eye');
          icon.classList.add('fa-eye-slash');
        } else {
          input.type = 'password';
          icon.classList.remove('fa-eye-slash');
          icon.classList.add('fa-eye');
        }
      }
    });
  });

  // Live Password Validation & Matching
  const currentPassEl = document.getElementById('currentPassword');
  const newPassEl = document.getElementById('newPassword');
  const confirmPassEl = document.getElementById('confirmPassword');
  const reqLength = document.getElementById('req-length');
  const reqDiff = document.getElementById('req-diff');
  const reqMatch = document.getElementById('req-match');
  const form = document.getElementById('changePasswordForm');
  const btnSubmit = document.getElementById('btnSubmit');
  const dynamicAlert = document.getElementById('dynamicAlert');

  function updateChecklist() {
    const curVal = currentPassEl ? currentPassEl.value : '';
    const newVal = newPassEl ? newPassEl.value : '';
    const confVal = confirmPassEl ? confirmPassEl.value : '';

    // 1. Length >= 6
    if (newVal.length >= 6) {
      reqLength.classList.add('met');
      reqLength.querySelector('i').className = 'fa-solid fa-circle-check';
    } else {
      reqLength.classList.remove('met');
      reqLength.querySelector('i').className = 'fa-regular fa-circle';
    }

    // 2. Different from current
    if (newVal.length > 0 && curVal.length > 0 && newVal !== curVal) {
      reqDiff.classList.add('met');
      reqDiff.querySelector('i').className = 'fa-solid fa-circle-check';
    } else {
      reqDiff.classList.remove('met');
      reqDiff.querySelector('i').className = 'fa-regular fa-circle';
    }

    // 3. Match
    if (newVal.length > 0 && confVal.length > 0 && newVal === confVal) {
      reqMatch.classList.add('met');
      reqMatch.querySelector('i').className = 'fa-solid fa-circle-check';
    } else {
      reqMatch.classList.remove('met');
      reqMatch.querySelector('i').className = 'fa-regular fa-circle';
    }
  }

  if (currentPassEl) currentPassEl.addEventListener('input', updateChecklist);
  if (newPassEl) newPassEl.addEventListener('input', updateChecklist);
  if (confirmPassEl) confirmPassEl.addEventListener('input', updateChecklist);

  // Asynchronous Fetch Submission with Graceful Fallback
  if (form) {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      const currentPassword = currentPassEl.value.trim();
      const newPassword = newPassEl.value.trim();
      const confirmPassword = confirmPassEl.value.trim();

      function showAlert(type, msg) {
        dynamicAlert.style.display = 'flex';
        dynamicAlert.className = 'alert alert-' + type;
        const iconClass = type === 'success' ? 'fa-solid fa-circle-check' : 'fa-solid fa-circle-exclamation';
        dynamicAlert.innerHTML = '<i class="' + iconClass + '" style="margin-top:2px;"></i><div>' + msg + '</div>';
        dynamicAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      if (!currentPassword || !newPassword || !confirmPassword) {
        showAlert('danger', 'Please fill in all password fields.');
        return;
      }

      if (newPassword.length < 6) {
        showAlert('danger', 'New password must contain at least 6 characters.');
        return;
      }

      if (newPassword !== confirmPassword) {
        showAlert('danger', 'New password and confirmation password do not match.');
        return;
      }

      if (currentPassword === newPassword) {
        showAlert('danger', 'New password must be different from your current password.');
        return;
      }

      btnSubmit.disabled = true;
      btnSubmit.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Updating...</span>';

      try {
        const response = await fetch('/user/change_pass', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          showAlert('success', data.message || 'Password changed successfully!');
          form.reset();
          updateChecklist();
          setTimeout(() => {
            window.location.href = '/user';
          }, 1800);
        } else {
          showAlert('danger', data.message || 'Unable to update password. Please check your credentials.');
        }
      } catch (err) {
        // Fallback: submit standard form if fetch fails
        form.submit();
      } finally {
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = '<i class="fa-solid fa-shield-halved"></i> <span>Update Password</span>';
      }
    });
  }
</script>

</body>
</html>
