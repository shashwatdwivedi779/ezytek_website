  var msg  = msgEl ? msgEl.value.trim() : '';

  var text = 'Hello Ezytek Clean Team,\nMy name is ' + name + '.\nI am interested in: ' + prod + '.';
  if (msg) {
    text += '\nRequirement details: ' + msg;
  }

  var waUrl = 'https://wa.me/919311313886?text=' + encodeURIComponent(text);
  window.open(waUrl, '_blank');
}
</script>

