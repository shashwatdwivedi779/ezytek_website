<!-- ============================================================
     SECTION 4b: LIVE PRODUCTS FROM DATABASE
     ============================================================ -->
<% const hasProducts = data && data.some(d => d && d.length > 0); %>
<% if (hasProducts) { %>
<section class="live-products" aria-labelledby="live-products-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow anim-fade-up">Our Catalogue</span>
      <h2 class="section-title anim-fade-up anim-delay-1" id="live-products-heading">Products by Category</h2>
      <p class="section-subtitle anim-fade-up anim-delay-2">Browse our complete range of industrial cleaning machinery, sourced directly from our product database.</p>
    </div>
    <% data.forEach((datas, idx) => { %>
      <% if (datas && datas.length > 0) { %>
      <div class="live-category-group anim-fade-up">
        <div class="live-cat-header">
          <div class="live-cat-title-wrap">
            <h3 class="live-cat-title"><%= datas[0].category %></h3>
            <span class="live-cat-count"><%= datas.length %> <%= datas.length === 1 ? 'item' : 'items' %></span>
          </div>
          <div class="live-cat-actions">
            <a href="/products" class="live-cat-link">
              View All
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <div class="live-scroll-controls" aria-label="Scroll products">
              <button class="live-scroll-btn live-scroll-btn-prev" onclick="scrollProductTrack(this, -1)" aria-label="Scroll left" type="button">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
              </button>
              <button class="live-scroll-btn live-scroll-btn-next" onclick="scrollProductTrack(this, 1)" aria-label="Scroll right" type="button">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            </div>
          </div>
        </div>

        <div class="live-products-track-wrap">
          <div class="live-products-track">
            <% datas.forEach(p => { %>
            <article class="live-product-card">
              <div class="live-product-img">
                <% 
                  let imgSrc = '/category/pressure_washer.png';
                  let rawMain = p.main_image;
                  if (Array.isArray(rawMain)) rawMain = rawMain[0];
                  if (rawMain) {
                    const imgTrimmed = String(rawMain).trim();
                    if (imgTrimmed.startsWith('http://') || imgTrimmed.startsWith('https://')) {
                      imgSrc = imgTrimmed;
                    } else if (imgTrimmed.startsWith('/uploads/')) {
                      imgSrc = imgTrimmed;
                    } else if (imgTrimmed.startsWith('uploads/')) {
                      imgSrc = '/' + imgTrimmed;
                    } else {
                      imgSrc = '/uploads/' + imgTrimmed;
                    }
                  }
                %>
                <img src="<%= imgSrc %>" alt="<%= p.productName || 'Industrial Product' %>" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/category/pressure_washer.png';" />
                <% if (p.discount > 0) { %><span class="live-product-badge"><%= p.discount %>% OFF</span><% } %>
              </div>
              <div class="live-product-body">
                <h4 class="live-product-name" title="<%= p.productName %>"><%= p.productName %></h4>
                <div class="live-product-pricing">
                  <% if (p.finalPrice) { %>
                    <span class="live-product-price">₹<%= Number(p.finalPrice).toLocaleString('en-IN') %></span>
                  <% } %>
                  <% if (p.price && p.discount > 0) { %>
                    <span class="live-product-mrp">₹<%= Number(p.price).toLocaleString('en-IN') %></span>
                  <% } %>
                </div>
                <a href="/products/<%= p._id %>" class="btn btn-xs btn-xs-primary live-product-btn">View Details</a>
              </div>
            </article>
            <% }) %>
          </div>
        </div>
      </div>
      <% } %>
    <% }) %>
  </div>
</section>
<% } %>



