<!-- ── Apple-style Scroll Frame Animation ──────────────────────────── -->
<script>
(function () {
  // ── CONFIG ───────────────────────────────────────────────────────────
  var TOTAL_FRAMES = 300;                     // 300 frames total
  var FRAME_PREFIX = '/frame_images/ezgif-frame-';  // exact folder + filename prefix
  var FRAME_EXT    = '.jpg';
  // ─────────────────────────────────────────────────────────────────────

  /* Zero-pad frame number: 1 → "001", 12 → "012", 300 → "300" */
  function padFrame(n) {
    return n < 10 ? '00' + n : n < 100 ? '0' + n : '' + n;
  }

  var canvas      = document.getElementById('frameCanvas');
  var ctx         = canvas.getContext('2d');
  var loader      = document.getElementById('frameLoader');
  var loaderFill  = document.getElementById('frameLoaderFill');
  var loaderText  = document.getElementById('frameLoaderText');
  var captionWrap = document.getElementById('frameCaptionWrap');

  var frames         = [];
  var currentFrame   = 0;
  var rafPending     = false;

  /* ── Responsive canvas: fills viewport with cover-fit ── */
  function resizeCanvas() {
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
    drawFrame(currentFrame);
  }
  window.addEventListener('resize', resizeCanvas, { passive: true });
  resizeCanvas();

  /* ── Draw a single frame, cover-scaled ── */
  function drawFrame(index) {
    var i   = Math.max(0, Math.min(TOTAL_FRAMES - 1, Math.round(index)));
    var img = frames[i];
    if (!img || !img.complete || !img.naturalWidth) return;
    currentFrame = i;

    var cw = canvas.width,  ch = canvas.height;
    var iw = img.naturalWidth, ih = img.naturalHeight;
    var scale  = Math.max(cw / iw, ch / ih);
    var drawW  = iw * scale,  drawH = ih * scale;
    var dx     = (cw - drawW) / 2, dy = (ch - drawH) / 2;

    ctx.clearRect(0, 0, cw, ch);
    ctx.drawImage(img, dx, dy, drawW, drawH);
  }

  /* ── Preload all frames, show progress ── */
  function preload(onDone) {
    document.body.style.overflow = 'hidden'; // lock scroll during load
    var loaded = 0;
    for (var i = 1; i <= TOTAL_FRAMES; i++) {
      (function (idx) {
        var img = new Image();
        img.src = FRAME_PREFIX + padFrame(idx) + FRAME_EXT;
        frames[idx - 1] = img;
        img.onload = img.onerror = function () {
          loaded++;
          var pct = Math.round((loaded / TOTAL_FRAMES) * 100);
          loaderFill.style.width = pct + '%';
          loaderText.textContent = pct + '%';
          if (loaded === TOTAL_FRAMES) onDone();
        };
      })(i);
    }
  }

  /* ── Init GSAP scroll animation after preload ── */
  function initAnimation() {
    document.body.style.overflow = ''; // restore scroll

    // Fade out loader
    loader.classList.add('hidden');
    setTimeout(function () { loader.style.display = 'none'; }, 520);

    drawFrame(0); // paint first frame immediately

    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      console.warn('GSAP not available — frame animation skipped.');
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    var anim = { frame: 0 };

    gsap.to(anim, {
      frame: TOTAL_FRAMES - 1,
      ease: 'none',
      snap: { snapTo: 1, duration: 0 },
      scrollTrigger: {
        trigger: '#frameScrollSection',
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.6,
        onUpdate: function (self) {
          if (!rafPending) {
            rafPending = true;
            requestAnimationFrame(function () {
              drawFrame(anim.frame);
              rafPending = false;
            });
          }
          // Fade caption in during the second half of the scroll
          if (captionWrap) {
            captionWrap.style.opacity = self.progress > 0.45
              ? Math.min(1, (self.progress - 0.45) * 2.5).toFixed(3)
              : '0';
          }
        }
      }
    });
  }

  /* ── Load GSAP from CDN if not already on the page ── */
  function loadScript(src, cb) {
    var s   = document.createElement('script');
    s.src   = src;
    s.onload = cb;
    document.head.appendChild(s);
  }

  /* ── Entry point ── */
  preload(function () {
    if (typeof gsap !== 'undefined') {
      initAnimation();
    } else {
      loadScript(
        'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js',
        function () {
          loadScript(
            'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js',
            initAnimation
          );
        }
      );
    }
  });
})();

// WhatsApp Direct Lead Generator for Homepage Contact Section
function handleHomeWhatsAppRedirect(e) {
  e.preventDefault();
  var nameEl = document.getElementById('homeContactName');
  var prodEl = document.getElementById('homeContactProduct');
