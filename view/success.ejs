
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Success | Confirmation</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background: #f3f6fa;
        }

        .success-container {
            width: 100%;
            max-width: 480px;
            background: #ffffff;
            padding: 50px 35px;
            border-radius: 18px;
            text-align: center;
            box-shadow: 0 15px 50px rgba(15, 23, 42, 0.08);
            animation: appear 0.6s ease;
        }

        .success-icon {
            width: 85px;
            height: 85px;
            margin: 0 auto 25px;
            border-radius: 50%;
            background: #e7f8ef;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: pop 0.5s ease 0.2s both;
        }

        .success-icon svg {
            width: 43px;
            height: 43px;
            stroke: #16a36a;
            stroke-width: 3;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .success-container h1 {
            font-size: 29px;
            font-weight: 800;
            color: #102a43;
            margin-bottom: 13px;
        }

        .success-container .message {
            font-size: 15px;
            color: #64748b;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        .success-container .reason {
            color: #16a36a;
            font-weight: 700;
        }

        .success-divider {
            width: 50px;
            height: 3px;
            background: #d1f0df;
            border-radius: 10px;
            margin: 0 auto 25px;
        }

        .back-btn {
            display: inline-block;
            text-decoration: none;
            background: #1769aa;
            color: #ffffff;
            padding: 14px 28px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            transition: all 0.25s ease;
        }

        .back-btn:hover {
            background: #10558c;
            transform: translateY(-3px);
            box-shadow: 0 7px 18px rgba(23, 105, 170, 0.2);
        }

        .footer-text {
            font-size: 11px;
            color: #a0aec0;
            margin-top: 28px;
        }

        @keyframes appear {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes pop {
            from {
                transform: scale(0.5);
                opacity: 0;
            }
            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        @media(max-width: 480px) {
            .success-container {
                padding: 40px 22px;
            }

            .success-container h1 {
                font-size: 25px;
            }
        }
    </style>
</head>

<body>

    <div class="success-container">

        <div class="success-icon">
            <svg viewBox="0 0 24 24">
                <path d="M5 12.5L10 17L19 7"/>
            </svg>
        </div>

        <h1>Congratulations!</h1>

        <div class="success-divider"></div>

        <p class="message">
            <span class="reason"><%= reason %></span>
            Successfully!
            <br>
            Your request has been processed successfully.
        </p>

        <a href="<%= return_to %>" class="back-btn">
            ← Go To Back
        </a>

        <p class="footer-text">
            Thank you for choosing us.
        </p>

    </div>

</body>
</html>
