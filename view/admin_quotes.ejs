<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Quotation Management | Ezytek Clean</title>

  <!-- Google Fonts: Inter & Poppins -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">

  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/css/admin_quotes.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body>

  <!-- ================= TOP ADMIN NAVIGATION BAR ================= -->
  <header style="background: #ffffff; border-bottom: 1px solid var(--border-light); padding: 14px 28px; box-shadow: var(--shadow-xs); position: sticky; top: 0; z-index: 100;">
    <div style="max-width: 1360px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 16px;">
      
      <!-- Logo -->
      <a href="/user" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
        <div style="width: 40px; height: 40px; border-radius: var(--radius-md); background: #FFFFFF; border: 1px solid var(--border-light, #E2E8F0); overflow: hidden; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(2, 132, 199, 0.12);">
          <img src="/uploads/logo_op.jpeg" alt="Ezytek Clean Logo" style="width: 100%; height: 100%; object-fit: contain;" onerror="this.onerror=null; this.src='/logo_op.jpeg';" />
        </div>
        <div>
          <div style="font-family: 'Poppins', sans-serif; font-size: 1.1rem; font-weight: 800; color: var(--brand-navy); line-height: 1.1;">EZYTEK <span style="color: var(--brand-blue);">Clean</span></div>
          <div style="font-size: 0.68rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;">Admin Control Portal</div>
        </div>
      </a>

      <!-- Quick Navigation Links -->
      <nav style="display: flex; align-items: center; gap: 8px;">
        <a href="/user" class="btn-header-secondary">
          <i class="fa-solid fa-gauge-high"></i>
          <span>Dashboard</span>
        </a>
        <a href="/master/products" class="btn-header-secondary">
          <i class="fa-solid fa-boxes-stacked"></i>
          <span>Products</span>
        </a>
        <a href="/master/upload" class="btn-header-secondary">
          <i class="fa-solid fa-plus-circle"></i>
          <span>Upload Machine</span>
        </a>
        <a href="/logout" class="btn-header-secondary" style="color: #DC2626;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
          <span>Logout</span>
        </a>
      </nav>

    </div>
  </header>

  <!-- ================= MAIN CONTENT CONTAINER ================= -->
  <main class="admin-container">

    <!-- Breadcrumbs -->
    <nav class="admin-breadcrumb" aria-label="Breadcrumb">
      <a href="/"><i class="fa-solid fa-house"></i> Home</a>
      <i class="fa-solid fa-chevron-right separator"></i>
      <a href="/user">Dashboard</a>
      <i class="fa-solid fa-chevron-right separator"></i>
      <span class="current">Quote Management</span>
    </nav>

    <!-- Page Title & Header Actions -->
    <div class="page-header-row">
      <div class="page-title-group">
        <h1>
          Quotation Management
          <span class="page-title-badge">Admin Suite</span>
        </h1>
        <p class="page-subtitle">
          Review, analyze, approve, or reject customer machinery proposals and commercial quotation requests.
        </p>
      </div>

      <div class="page-header-actions">
        <a href="/master/products" class="btn-header-secondary">
          <i class="fa-solid fa-store"></i> Browse Catalog
        </a>
        <button type="button" class="btn-header-secondary" onclick="window.print()">
          <i class="fa-solid fa-print"></i> Print Report
        </button>
      </div>
    </div>

    <!-- Alert Messages (Success / Error) -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="alert-banner alert-banner-success" id="successBanner">
        <div style="display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-circle-check"></i>
          <span><%= successMessage %></span>
        </div>
        <button class="alert-close-btn" onclick="document.getElementById('successBanner').remove();">&times;</button>
      </div>
    <% } %>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert-banner alert-banner-error" id="errorBanner">
        <div style="display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span><%= errorMessage %></span>
        </div>
        <button class="alert-close-btn" onclick="document.getElementById('errorBanner').remove();">&times;</button>
      </div>
    <% } %>

    <!-- KPI Metric Cards Grid -->
    <div class="stats-grid">
      <!-- Total Quotes -->
      <div class="stat-card <%= (typeof currentStatus !== 'undefined' && currentStatus === 'all') ? 'active-filter' : '' %>" onclick="filterByStatus('all')">
        <div class="stat-top-row">
          <div class="stat-icon-badge stat-icon-blue">
            <i class="fa-solid fa-file-invoice-dollar"></i>
          </div>
          <span class="stat-trend-tag">All Time</span>
        </div>
        <div class="stat-value"><%= (typeof stats !== 'undefined' && stats) ? stats.totalQuotes : quotes.length %></div>
        <div class="stat-label">Total Quotations</div>
      </div>

      <!-- Pending -->
      <div class="stat-card <%= (typeof currentStatus !== 'undefined' && currentStatus === 'Pending') ? 'active-filter' : '' %>" onclick="filterByStatus('Pending')">
        <div class="stat-top-row">
          <div class="stat-icon-badge stat-icon-amber">
            <i class="fa-solid fa-clock"></i>
          </div>
          <span class="stat-trend-tag" style="background: var(--status-pending-bg); color: var(--status-pending-text);">Action Required</span>
        </div>
        <div class="stat-value" style="color: var(--status-pending-text);"><%= (typeof stats !== 'undefined' && stats) ? stats.pending : 0 %></div>
        <div class="stat-label">Pending Review</div>
      </div>

      <!-- Approved -->
      <div class="stat-card <%= (typeof currentStatus !== 'undefined' && currentStatus === 'Approved') ? 'active-filter' : '' %>" onclick="filterByStatus('Approved')">
        <div class="stat-top-row">
          <div class="stat-icon-badge stat-icon-green">
            <i class="fa-solid fa-circle-check"></i>
          </div>
          <span class="stat-trend-tag" style="background: var(--status-approved-bg); color: var(--status-approved-text);">Accepted</span>
        </div>
        <div class="stat-value" style="color: var(--status-approved-text);"><%= (typeof stats !== 'undefined' && stats) ? stats.approved : 0 %></div>
        <div class="stat-label">Approved Quotes</div>
      </div>

      <!-- Contacted -->
      <div class="stat-card <%= (typeof currentStatus !== 'undefined' && currentStatus === 'Contacted') ? 'active-filter' : '' %>" onclick="filterByStatus('Contacted')">
        <div class="stat-top-row">
          <div class="stat-icon-badge stat-icon-blue">
            <i class="fa-solid fa-phone-volume"></i>
          </div>
          <span class="stat-trend-tag">In Dialogue</span>
        </div>
        <div class="stat-value"><%= (typeof stats !== 'undefined' && stats) ? stats.contacted : 0 %></div>
        <div class="stat-label">Contacted Leads</div>
      </div>

      <!-- Pipeline Value -->
      <div class="stat-card">
        <div class="stat-top-row">
          <div class="stat-icon-badge stat-icon-purple">
            <i class="fa-solid fa-indian-rupee-sign"></i>
          </div>
          <span class="stat-trend-tag">Pipeline</span>
        </div>
        <div class="stat-value" style="font-size: 1.5rem;">
          ₹<%= (typeof stats !== 'undefined' && stats && stats.totalValue) ? stats.totalValue.toLocaleString('en-IN') : '0' %>
        </div>
        <div class="stat-label">Total Commercial Pipeline</div>
      </div>
    </div>

    <!-- Control Bar: Search & Status Filters -->
    <div class="control-bar">
      <!-- Search Input -->
      <div class="search-box-wrapper">
        <i class="fa-solid fa-magnifying-glass search-icon"></i>
        <input 
          type="text" 
          id="quoteSearchInput" 
          class="search-input" 
          placeholder="Search by customer, company, phone, email, product..." 
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          aria-label="Search quotations"
          oninput="handleSearch(this.value)"
        >
        <button type="button" id="searchClearBtn" class="search-clear-btn" onclick="clearSearch()" aria-label="Clear search">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Status Filter Chips -->
      <div class="filter-chips-row">
        <button type="button" class="filter-chip <%= (!currentStatus || currentStatus === 'all') ? 'active' : '' %>" onclick="filterByStatus('all')">
          <span>All Quotes</span>
          <span class="filter-chip-count"><%= (typeof stats !== 'undefined' && stats) ? stats.totalQuotes : quotes.length %></span>
        </button>

        <button type="button" class="filter-chip <%= (currentStatus === 'Pending') ? 'active' : '' %>" onclick="filterByStatus('Pending')">
          <i class="fa-solid fa-clock" style="color: #D97706;"></i>
          <span>Pending</span>
          <span class="filter-chip-count"><%= (typeof stats !== 'undefined' && stats) ? stats.pending : 0 %></span>
        </button>

        <button type="button" class="filter-chip <%= (currentStatus === 'Contacted') ? 'active' : '' %>" onclick="filterByStatus('Contacted')">
          <i class="fa-solid fa-phone" style="color: #0284C7;"></i>
          <span>Contacted</span>
          <span class="filter-chip-count"><%= (typeof stats !== 'undefined' && stats) ? stats.contacted : 0 %></span>
        </button>

        <button type="button" class="filter-chip <%= (currentStatus === 'Approved') ? 'active' : '' %>" onclick="filterByStatus('Approved')">
          <i class="fa-solid fa-circle-check" style="color: #16A34A;"></i>
          <span>Approved</span>
          <span class="filter-chip-count"><%= (typeof stats !== 'undefined' && stats) ? stats.approved : 0 %></span>
        </button>

        <button type="button" class="filter-chip <%= (currentStatus === 'Rejected') ? 'active' : '' %>" onclick="filterByStatus('Rejected')">
          <i class="fa-solid fa-circle-xmark" style="color: #DC2626;"></i>
          <span>Rejected</span>
          <span class="filter-chip-count"><%= (typeof stats !== 'undefined' && stats) ? stats.rejected : 0 %></span>
        </button>

        <button type="button" class="filter-chip <%= (currentStatus === 'Completed') ? 'active' : '' %>" onclick="filterByStatus('Completed')">
          <i class="fa-solid fa-flag-checkered" style="color: #0F766E;"></i>
          <span>Completed</span>
          <span class="filter-chip-count"><%= (typeof stats !== 'undefined' && stats) ? stats.completed : 0 %></span>
        </button>
      </div>
    </div>

    <!-- Quotes Table Card -->
    <div class="table-card">
      <div class="table-responsive">
        <table class="quotes-table" id="quotesTable">
          <thead>
            <tr>
              <th scope="col">Quote Ref / Date</th>
              <th scope="col">Customer / Company</th>
              <th scope="col">Equipment Requested</th>
              <th scope="col">Quotation Value</th>
              <th scope="col">Status</th>
              <th scope="col" style="text-align: right;">Action</th>
            </tr>
          </thead>
          <tbody id="quotesTableBody">
            <% if (quotes && quotes.length > 0) { %>
              <% quotes.forEach(function(quote) { %>
                <% 
                  const quoteId = quote._id.toString();
                  const shortId = quoteId.slice(-6).toUpperCase();
                  const createdDate = new Date(quote.createdAt);
                  const formattedDate = createdDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
                  const formattedTime = createdDate.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
                  
                  const customerName = quote.user?.userName || quote.email.split('@')[0];
                  const companyName = quote.companyName || '';
                  const phoneClean = quote.phone.replace(/[^0-9]/g, '');

                  let prodImage = '/category/autometic_wash.png';
                  if (quote.product && quote.product.main_image) {
                    let raw = quote.product.main_image;
                    if (Array.isArray(raw)) raw = raw[0];
                    if (raw) {
                      const str = String(raw).trim();
                      prodImage = str.startsWith('http') 
                        ? str 
                        : (str.startsWith('/') ? str : '/uploads/' + str);
                    }
                  }
                %>
                <tr 
                  class="quote-row" 
                  data-id="<%= quoteId %>"
                  data-status="<%= quote.status %>"
                  data-search="<%= (quote.productName + ' ' + customerName + ' ' + companyName + ' ' + quote.email + ' ' + quote.phone + ' ' + shortId).toLowerCase() %>"
                >
                  <!-- Ref ID & Date -->
                  <td>
                    <div class="quote-id-cell">
                      <a href="/master/quotes/<%= quoteId %>" class="quote-id-link" title="Open full quotation analysis">
                        #Q-<%= shortId %>
                      </a>
                      <span class="quote-date-sub">
                        <i class="fa-regular fa-calendar" style="margin-right: 3px;"></i> <%= formattedDate %>
                      </span>
                      <span class="quote-date-sub" style="font-size: 0.7rem; color: var(--text-light);">
                        <%= formattedTime %>
                      </span>
                    </div>
                  </td>

                  <!-- Customer & Company -->
                  <td>
                    <div class="customer-lead-cell">
                      <div class="lead-name"><%= customerName %></div>
                      <% if (companyName) { %>
                        <div class="lead-company-badge" title="<%= companyName %>">
                          <i class="fa-solid fa-building"></i> <%= companyName %>
                        </div>
                      <% } %>
                      <div class="lead-contact-links">
                        <a href="mailto:<%= quote.email %>" title="Send email: <%= quote.email %>">
                          <i class="fa-regular fa-envelope"></i> <%= quote.email %>
                        </a>
                      </div>
                      <div class="lead-contact-links">
                        <a href="tel:<%= quote.phone %>" title="Call: <%= quote.phone %>">
                          <i class="fa-solid fa-phone"></i> <%= quote.phone %>
                        </a>
                        <% if (phoneClean) { %>
                          <a href="https://wa.me/<%= phoneClean.length === 10 ? '91' + phoneClean : phoneClean %>?text=Hello%20<%= encodeURIComponent(customerName) %>,%20thank%20you%20for%20your%20quotation%20request%20for%20<%= encodeURIComponent(quote.productName) %>." target="_blank" rel="noopener noreferrer" style="color: #16A34A;" title="Chat on WhatsApp">
                            <i class="fa-brands fa-whatsapp"></i>
                          </a>
                        <% } %>
                      </div>
                    </div>
                  </td>

                  <!-- Machinery Requested -->
                  <td>
                    <div class="product-cell">
                      <div class="product-thumb-box">
                        <img src="<%= prodImage %>" alt="<%= quote.productName %>" onerror="this.src='/category/autometic_wash.png'">
                      </div>
                      <div class="product-meta-wrap">
                        <a href="/master/quotes/<%= quoteId %>" class="product-name-link" title="<%= quote.productName %>">
                          <%= quote.productName %>
                        </a>
                        <span class="product-qty-sub">
                          Quantity: <strong><%= quote.quantity %> unit<%= quote.quantity > 1 ? 's' : '' %></strong>
                        </span>
                        <span class="product-qty-sub" style="font-size: 0.72rem;">
                          Unit: ₹<%= (quote.unitPrice || 0).toLocaleString('en-IN') %>
                        </span>
                      </div>
                    </div>
                  </td>

                  <!-- Value -->
                  <td>
                    <div class="value-cell">
                      <div class="total-value-strong">₹<%= (quote.totalPrice || 0).toLocaleString('en-IN') %></div>
                      <div class="unit-value-sub">Total Proposal</div>
                    </div>
                  </td>

                  <!-- Status Badge -->
                  <td>
                    <span class="status-badge status-<%= quote.status %>" id="status-badge-<%= quoteId %>">
                      <% if (quote.status === 'Pending') { %>
                        <i class="fa-solid fa-clock"></i>
                      <% } else if (quote.status === 'Contacted') { %>
                        <i class="fa-solid fa-phone"></i>
                      <% } else if (quote.status === 'Approved') { %>
                        <i class="fa-solid fa-circle-check"></i>
                      <% } else if (quote.status === 'Rejected') { %>
                        <i class="fa-solid fa-circle-xmark"></i>
                      <% } else if (quote.status === 'Completed') { %>
                        <i class="fa-solid fa-flag-checkered"></i>
                      <% } %>
                      <%= quote.status %>
                    </span>
                  </td>

                  <!-- Actions -->
                  <td class="actions-cell">
                    <div class="action-btns-group">
                      <!-- Manage / Analyse Details -->
                      <a href="/master/quotes/<%= quoteId %>" class="btn-action-manage" title="Analyse & Manage Quote">
                        <span>Manage</span>
                        <i class="fa-solid fa-arrow-right"></i>
                      </a>

                      <!-- Quick Accept (if not already approved) -->
                      <% if (quote.status !== 'Approved') { %>
                        <button 
                          type="button" 
                          class="btn-action-accept" 
                          title="Quick Accept / Approve Quote" 
                          onclick="openAcceptModal('<%= quoteId %>', '<%= quote.productName %>', '<%= customerName %>')"
                        >
                          <i class="fa-solid fa-check"></i>
                        </button>
                      <% } %>

                      <!-- Delete Quote -->
                      <button 
                        type="button" 
                        class="btn-action-delete" 
                        title="Delete Quote Record" 
                        onclick="openDeleteModal('<%= quoteId %>', '#Q-<%= shortId %>', '<%= customerName %>')"
                      >
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Empty State Container -->
      <div id="noResultsState" class="empty-quotes-state" style="<%= (!quotes || quotes.length === 0) ? 'display: flex;' : 'display: none;' %>">
        <div class="empty-icon-circle">
          <i class="fa-solid fa-file-invoice"></i>
        </div>
        <h3 class="empty-title">No Quotation Requests Found</h3>
        <p class="empty-desc" id="emptyDesc">
          There are currently no customer quotations matching your selected filter. All incoming commercial quotation enquiries from buyers will appear here.
        </p>
        <button type="button" class="btn-header-secondary" onclick="resetFilters()">
          <i class="fa-solid fa-rotate-left"></i> Reset Filter
        </button>
      </div>

    </div>

  </main>

  <!-- ================= MODAL: QUICK ACCEPT CONFIRMATION ================= -->
  <div class="modal-overlay" id="acceptModal">
    <div class="modal-content-card">
      <div class="modal-header">
        <div class="modal-icon modal-icon-success">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <h3 class="modal-title">Accept &amp; Approve Quote?</h3>
      </div>
      <p class="modal-body">
        Are you sure you want to approve the commercial proposal for <strong id="acceptModalCustomer">Customer</strong> regarding <strong id="acceptModalProduct">Product</strong>? 
        The quotation status will be updated to <strong>Approved</strong>.
      </p>
      <form id="acceptForm" method="POST" action="">
        <input type="hidden" name="status" value="Approved">
        <div class="modal-actions">
          <button type="button" class="btn-modal-cancel" onclick="closeAcceptModal()">Cancel</button>
          <button type="submit" class="btn-modal-confirm-accept">
            <i class="fa-solid fa-check"></i> Approve Quote
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= MODAL: DELETE CONFIRMATION ================= -->
  <div class="modal-overlay" id="deleteModal">
    <div class="modal-content-card">
      <div class="modal-header">
        <div class="modal-icon modal-icon-danger">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h3 class="modal-title">Delete Quotation Record?</h3>
      </div>
      <p class="modal-body">
        Are you sure you want to permanently delete quotation <strong id="deleteModalRef">#Q-...</strong> for <strong id="deleteModalCustomer">Customer</strong>? 
        This action cannot be undone and will remove all enquiry notes and records.
      </p>
      <form id="deleteForm" method="POST" action="">
        <div class="modal-actions">
          <button type="button" class="btn-modal-cancel" onclick="closeDeleteModal()">Cancel</button>
          <button type="submit" class="btn-modal-confirm-delete">
            <i class="fa-solid fa-trash-can"></i> Delete Permanently
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Global Footer -->
  <%- include('footer.ejs') %>

  <!-- ================= CLIENT FILTER & SEARCH SCRIPT ================= -->
  <script>
    let activeStatusFilter = '<%= typeof currentStatus !== "undefined" ? currentStatus : "all" %>';
    let currentSearchTerm = '';

    function handleSearch(term) {
      currentSearchTerm = term.trim().toLowerCase();
      const clearBtn = document.getElementById('searchClearBtn');
      if (clearBtn) {
        clearBtn.style.display = currentSearchTerm.length > 0 ? 'block' : 'none';
      }
      applyFilters();
    }

    function clearSearch() {
      const input = document.getElementById('quoteSearchInput');
      if (input) {
        input.value = '';
        currentSearchTerm = '';
        document.getElementById('searchClearBtn').style.display = 'none';
        applyFilters();
      }
    }

    function filterByStatus(status) {
      activeStatusFilter = status;
      
      // Update UI active chip
      document.querySelectorAll('.filter-chip').forEach(chip => {
        chip.classList.toggle('active', chip.getAttribute('onclick').includes(`'${status}'`));
      });

      // Update stat cards active style
      document.querySelectorAll('.stat-card').forEach(card => {
        card.classList.toggle('active-filter', card.getAttribute('onclick')?.includes(`'${status}'`));
      });

      applyFilters();
    }

    function applyFilters() {
      const rows = document.querySelectorAll('.quote-row');
      let visibleCount = 0;

      rows.forEach(row => {
        const rowStatus = row.getAttribute('data-status');
        const rowSearchData = row.getAttribute('data-search') || '';

        const matchesStatus = (activeStatusFilter === 'all') || (rowStatus === activeStatusFilter);
        const matchesSearch = (!currentSearchTerm) || rowSearchData.includes(currentSearchTerm);

        if (matchesStatus && matchesSearch) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      const tableEl = document.getElementById('quotesTable');
      const emptyStateEl = document.getElementById('noResultsState');
      const emptyDescEl = document.getElementById('emptyDesc');

      if (visibleCount === 0) {
        if (tableEl) tableEl.style.display = 'none';
        if (emptyStateEl) emptyStateEl.style.display = 'flex';
        if (emptyDescEl) {
          if (currentSearchTerm) {
            emptyDescEl.textContent = `No quotes matched your search "${currentSearchTerm}". Try different keywords or clear filters.`;
          } else {
            emptyDescEl.textContent = `No quotations found with status "${activeStatusFilter}".`;
          }
        }
      } else {
        if (tableEl) tableEl.style.display = 'table';
        if (emptyStateEl) emptyStateEl.style.display = 'none';
      }
    }

    function resetFilters() {
      clearSearch();
      filterByStatus('all');
    }

    // Modal Helpers
    function openAcceptModal(quoteId, productName, customerName) {
      document.getElementById('acceptModalProduct').textContent = productName;
      document.getElementById('acceptModalCustomer').textContent = customerName;
      document.getElementById('acceptForm').action = '/master/quotes/status/' + quoteId;
      document.getElementById('acceptModal').classList.add('active');
    }

    function closeAcceptModal() {
      document.getElementById('acceptModal').classList.remove('active');
    }

    function openDeleteModal(quoteId, refCode, customerName) {
      document.getElementById('deleteModalRef').textContent = refCode;
      document.getElementById('deleteModalCustomer').textContent = customerName;
      document.getElementById('deleteForm').action = '/master/quotes/delete/' + quoteId;
      document.getElementById('deleteModal').classList.add('active');
    }

    function closeDeleteModal() {
      document.getElementById('deleteModal').classList.remove('active');
    }

    // Close modals on escape key or clicking backdrop
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAcceptModal();
        closeDeleteModal();
      }
    });

    document.querySelectorAll('.modal-overlay').forEach(modal => {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.remove('active');
        }
      });
    });

    // Auto-dismiss alert banner after 5 seconds
    setTimeout(() => {
      const sBanner = document.getElementById('successBanner');
      if (sBanner) sBanner.style.display = 'none';
    }, 5000);
  </script>

</body>
</html>
