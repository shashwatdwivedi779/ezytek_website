<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Turnkey Car-Washing Setup — Coming Soon | Ezytek Clean</title>
  <meta name="description" content="Turnkey commercial car-washing bay layouts, automated wash plant packages, water recycling systems, and franchise setups from Ezytek Clean Pvt. Ltd." />

  <!-- Google Fonts: Inter & Poppins -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">

  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <!-- Core Theme Styles -->
  <link rel="stylesheet" href="/css/nav.css">
  <link rel="stylesheet" href="/css/footer.css">

  <style>
    :root {
      --brand-navy: #0F2038;
      --brand-blue: #0284C7;
      --brand-blue-hover: #0369A1;
      --brand-blue-subtle: #E0F2FE;
      --brand-blue-border: #BAE6FD;
      --bg-page: #F8FAFC;
      --bg-surface: #FFFFFF;
      --bg-subtle: #F1F5F9;
      --border-light: #E2EAF4;
      --text-primary: #0F172A;
      --text-secondary: #334155;
      --text-muted: #64748B;
      --radius-md: 10px;
      --radius-lg: 16px;
      --radius-pill: 9999px;
      --shadow-card: 0 4px 16px rgba(15, 32, 56, 0.06);
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-primary);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .setup-page-wrapper {
      flex: 1;
      max-width: 1200px;
      margin: 0 auto;
      padding: 48px 24px 80px;
      width: 100%;
      box-sizing: border-box;
    }

    .setup-hero-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: 56px 40px;
      box-shadow: var(--shadow-card);
      text-align: center;
      position: relative;
      overflow: hidden;
      margin-bottom: 40px;
    }

    .setup-hero-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--brand-blue), #06B6D4, #10B981);
    }

    .coming-soon-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 18px;
      background: var(--brand-blue-subtle);
      border: 1px solid var(--brand-blue-border);
      color: var(--brand-blue-hover);
      border-radius: var(--radius-pill);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .setup-headline {
      font-family: 'Poppins', sans-serif;
      font-size: clamp(2rem, 4vw, 2.85rem);
      font-weight: 800;
      color: var(--brand-navy);
      line-height: 1.2;
      margin-bottom: 16px;
      letter-spacing: -0.02em;
    }

    .setup-headline span {
      color: var(--brand-blue);
    }

    .setup-subtext {
      font-size: 1.05rem;
      color: var(--text-secondary);
      max-width: 680px;
      margin: 0 auto 36px;
      line-height: 1.65;
    }

    .setup-actions-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .btn-whatsapp-setup {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #16A34A;
      color: #FFFFFF;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 14px 28px;
      border-radius: var(--radius-md);
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(22, 163, 74, 0.28);
      transition: all 0.2s ease;
    }

    .btn-whatsapp-setup:hover {
      background: #15803D;
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(22, 163, 74, 0.35);
    }

    .btn-call-setup {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: var(--brand-navy);
      color: #FFFFFF;
      font-weight: 600;
      font-size: 0.95rem;
      padding: 14px 24px;
      border-radius: var(--radius-md);
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .btn-call-setup:hover {
      background: #1E293B;
      transform: translateY(-2px);
    }

    .btn-catalog-setup {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--bg-subtle);
      color: var(--text-secondary);
      font-weight: 600;
      font-size: 0.95rem;
      padding: 14px 24px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-light);
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .btn-catalog-setup:hover {
      background: #E2E8F0;
      color: var(--brand-navy);
    }

    /* ── Features Pillars Grid ── */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-top: 10px;
    }

    .feature-box {
      background: var(--bg-surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      padding: 24px 20px;
      text-align: left;
      box-shadow: 0 2px 6px rgba(15, 32, 56, 0.04);
      transition: transform 0.2s ease;
    }

    .feature-box:hover {
      transform: translateY(-3px);
      border-color: var(--brand-blue-border);
    }

    .feature-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: var(--brand-blue-subtle);
      color: var(--brand-blue);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      margin-bottom: 16px;
    }

    .feature-title {
      font-family: 'Poppins', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--brand-navy);
      margin-bottom: 8px;
    }

    .feature-desc {
      font-size: 0.85rem;
      color: var(--text-secondary);
      line-height: 1.5;
    }

    @media (max-width: 900px) {
      .features-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .setup-hero-card {
        padding: 36px 20px;
      }
    }

    @media (max-width: 580px) {
      .features-grid {
        grid-template-columns: 1fr;
      }
      .setup-actions-row {
        flex-direction: column;
        align-items: stretch;
      }
      .btn-whatsapp-setup, .btn-call-setup, .btn-catalog-setup {
        justify-content: center;
      }
    }
  </style>
</head>
<body>

  <!-- Navigation Partial -->
  <%- include('nav') %>

  <!-- Main Content Wrapper -->
  <main class="setup-page-wrapper">

    <!-- Hero Card -->
    <section class="setup-hero-card">
      <div class="coming-soon-badge">
        <i class="fa-solid fa-rocket"></i>
        <span>Launching Soon • Turnkey Franchise &amp; Station Setup</span>
      </div>

      <h1 class="setup-headline">
        Turnkey Automated <br />
        <span>Car-Washing Setup Packages</span>
      </h1>

      <p class="setup-subtext">
        We are engineering comprehensive turnkey vehicle wash packages — complete with 3D bay architecture layouts, water recycling plants, touchless wash arches, and commercial franchise blueprints.
      </p>

      <div class="setup-actions-row">
        <!-- Direct WhatsApp -->
        <a 
          href="https://wa.me/919311313886?text=Hello%20Ezytek%20Clean%20Team,%20I%20am%20planning%20a%20commercial%20Car-Washing%20Setup.%20Please%20connect%20me%20with%20a%20technical%20consultant%20for%20project%20details." 
          class="btn-whatsapp-setup" 
          target="_blank" 
          rel="noopener noreferrer"
        >
          <i class="fa-brands fa-whatsapp" style="font-size: 1.25rem;"></i>
          <span>Chat on WhatsApp (+91 93113 13886)</span>
        </a>

        <!-- Direct Phone -->
        <a href="tel:+919311313886" class="btn-call-setup">
          <i class="fa-solid fa-phone"></i>
          <span>Call: +91 93113 13886</span>
        </a>

        <!-- Browse Existing Products -->
        <a href="/products/car-wash-plants" class="btn-catalog-setup">
          <i class="fa-solid fa-store"></i>
          <span>View Wash Machines</span>
        </a>
      </div>
    </section>

    <!-- 4 Pillars Preview Grid -->
    <section class="features-grid" aria-label="Upcoming Car Washing Setup Capabilities">
      
      <!-- 1. Civil & Bay Layouts -->
      <div class="feature-box">
        <div class="feature-icon">
          <i class="fa-solid fa-draw-polygon"></i>
        </div>
        <h2 class="feature-title">3D Bay Architectural Design</h2>
        <p class="feature-desc">
          Precision CAD civil drawings, drainage trench blueprints, vehicle turning radius calculations, and entry/exit bay planning tailored to your plot size.
        </p>
      </div>

      <!-- 2. Equipment Integration -->
      <div class="feature-box">
        <div class="feature-icon">
          <i class="fa-solid fa-shower"></i>
        </div>
        <h2 class="feature-title">High-Throughput Machinery</h2>
        <p class="feature-desc">
          Automated rollover gantry arches, touchless contour wash systems, chassis underbody blasters, and 3-minute rapid dry blowers.
        </p>
      </div>

      <!-- 3. Water Recycling -->
      <div class="feature-box">
        <div class="feature-icon">
          <i class="fa-solid fa-droplet"></i>
        </div>
        <h2 class="feature-title">Eco Water Recycling Plants</h2>
        <p class="feature-desc">
          Multi-stage biological and sand filtration recycling systems saving up to 85% fresh water with integrated oil-water separators.
        </p>
      </div>

      <!-- 4. Automation & POS -->
      <div class="feature-box">
        <div class="feature-icon">
          <i class="fa-solid fa-microchip"></i>
        </div>
        <h2 class="feature-title">PLC Telemetry &amp; POS Controls</h2>
        <p class="feature-desc">
          Siemens PLC touchpanel telemetry, automated boom-barrier entry, POS digital billing, and real-time daily wash counter telemetry.
        </p>
      </div>

    </section>

  </main>

  <!-- Global Footer -->
  <%- include('footer') %>

</body>
</html>
