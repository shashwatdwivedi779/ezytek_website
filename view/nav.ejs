<script>
  // Self-contained core navbar behavior for any page including this partial
  (function() {
    const siteHeader = document.querySelector('.site-header');
    const hamburgerBtn = document.querySelector('.nav-hamburger');
    const mobileDrawer = document.getElementById('mobile-menu');
    const progressBar = document.querySelector('.scroll-progress-bar');
    const topBtn = document.querySelector('.back-to-top');

    // ── Active Page Glowing Navigation Highlighter ──
    function updateActiveNavLink() {
      const currentPath = (window.location.pathname || '/').replace(/\/+$/, '') || '/';
      const currentHash = window.location.hash || '';

      const navLinks = document.querySelectorAll('.nav-links .nav-link');
      const mobileLinks = document.querySelectorAll('.mobile-menu .mobile-nav-link');
      const iconBtns = document.querySelectorAll('.nav-actions .nav-icon-btn');
      const mobilePills = document.querySelectorAll('.mobile-actions-grid .mobile-action-pill');
      const quoteBtns = document.querySelectorAll('.nav-quote-btn, .mobile-quote-btn');

      // Clear previous active states
      navLinks.forEach(l => l.classList.remove('active'));
      mobileLinks.forEach(l => l.classList.remove('active'));
      iconBtns.forEach(b => b.classList.remove('active'));
      mobilePills.forEach(p => p.classList.remove('active'));
      quoteBtns.forEach(q => q.classList.remove('active'));

      // 1. Contact section (#contact)
      const contactSection = document.getElementById('contact');
      let isInContact = (currentHash === '#contact');
      if (!isInContact && currentPath === '/' && contactSection) {
        const rect = contactSection.getBoundingClientRect();
        if (rect.top <= 250 && rect.bottom >= 150) {
          isInContact = true;
        }
      }
      if (isInContact) {
        document.querySelectorAll('a[href="/#contact"], a[href="#contact"]').forEach(el => el.classList.add('active'));
        return;
      }

      // 2. WorkProof page (/workproof)
      if (currentPath === '/workproof' || currentHash === '#workproof') {
        document.querySelectorAll('a[href="/workproof"], a[href="/#workproof"]').forEach(el => el.classList.add('active'));
        return;
      }

      // 3. Car Washing Setup (/products/setup)
      if (currentPath === '/products/setup') {
        document.querySelectorAll('a[href="/products/setup"]').forEach(el => el.classList.add('active'));
        return;
      }

      // 4. Products Catalog & Details (/products, /products/..., /costomer/quote/...)
      if (currentPath === '/products' || (currentPath.startsWith('/products/') && currentPath !== '/products/setup') || currentPath.startsWith('/costomer/quote')) {
        document.querySelectorAll('a[href="/products"]').forEach(el => {
          if (el.classList.contains('nav-link') || el.classList.contains('mobile-nav-link')) {
            el.classList.add('active');
          }
        });
        return;
      }

      // 5. Cart / Saved Items (/user/card)
      if (currentPath.startsWith('/user/card')) {
        document.querySelectorAll('a[href="/user/card"]').forEach(el => el.classList.add('active'));
        return;
      }

      // 6. User Account / Master / Login (/user, /login, /signup, /master...)
      if (currentPath === '/user' || currentPath === '/login' || currentPath === '/signup' || currentPath.startsWith('/master')) {
        document.querySelectorAll('a[href="/user"], a[href="/login"]').forEach(el => {
          if (el.classList.contains('nav-icon-btn') || el.classList.contains('mobile-action-pill')) {
            el.classList.add('active');
          }
        });
        return;
      }

      // 7. Orders & Quotes (/user/orders, /user/quotes)
      if (currentPath === '/user/orders' || currentPath === '/user/quotes') {
        document.querySelectorAll('a[href="/user/card"]').forEach(el => el.classList.add('active'));
        return;
      }

      // 8. Home page default (when on / and not in contact)
      if (currentPath === '/') {
        document.querySelectorAll('a[href="/"]').forEach(el => {
          if (el.classList.contains('nav-link') || el.classList.contains('mobile-nav-link')) {
            el.classList.add('active');
          }
        });
      }
    }

    // Sticky shadow & progress updates
    function handleNavScroll() {
      const scrollY = window.scrollY || window.pageYOffset;
      if (siteHeader) {
        if (scrollY > 15) {
          siteHeader.classList.add('scrolled');
        } else {
          siteHeader.classList.remove('scrolled');
        }
      }
      if (progressBar) {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollY / docHeight) * 100 : 0;
        progressBar.style.width = Math.min(100, Math.max(0, progress)) + '%';
      }
      if (topBtn) {
        if (scrollY > 350) {
          topBtn.classList.add('visible');
        } else {
          topBtn.classList.remove('visible');
        }
      }

      // Check contact section viewport only on home page
      if (window.location.pathname === '/' || window.location.pathname === '') {
        updateActiveNavLink();
      }
    }

    window.addEventListener('scroll', handleNavScroll, { passive: true });
    window.addEventListener('hashchange', updateActiveNavLink);
    window.addEventListener('DOMContentLoaded', updateActiveNavLink);
    handleNavScroll();
    updateActiveNavLink();

    if (topBtn) {
      topBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Mobile Hamburger toggle (with single-bind guarantee & outside-click close)
    if (hamburgerBtn && mobileDrawer && !hamburgerBtn.dataset.bound) {
      hamburgerBtn.dataset.bound = 'true';

      function closeMobileDrawer() {
        hamburgerBtn.classList.remove('open');
        mobileDrawer.classList.remove('open');
        hamburgerBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      hamburgerBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = hamburgerBtn.classList.toggle('open');
        mobileDrawer.classList.toggle('open', isOpen);
        hamburgerBtn.setAttribute('aria-expanded', isOpen);
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });

      // Close mobile drawer when clicking any link inside it
      mobileDrawer.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          closeMobileDrawer();
        });
      });

      // Close if tapped outside header/drawer
      document.addEventListener('click', (e) => {
        if (mobileDrawer.classList.contains('open')) {
          if (!siteHeader.contains(e.target)) {
            closeMobileDrawer();
          }
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileDrawer.classList.contains('open')) {
          closeMobileDrawer();
        }
      });
    }
  })();
</script>
